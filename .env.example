GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
GROQ_VISION_MODEL=qwen/qwen3.8-27b
ANA_STT=local
USER_PET_NAME=
USER_SHORT_NAME=
USER_FULL_NAME=
ANA_VOICE=en_US-amy-medium
ANA_BROWSER=
ANA_TRUSTED_CONTACTS=
# Wake word model: a name matching a file in models/, or a full path to a custom .onnx
WAKE_WORD=alexa
WAKE_THRESHOLD=0.4
ANA_PROACTIVE=on
# Where lasting facts about the user are kept
MEMORY_FILE=data/memory.json
# Offline fallback model (ollama pull phi4-mini); empty picks any installed local model
OLLAMA_MODEL=phi4-mini
ASSISTANT_NAME=Ana
USER_NAME=
MIC_GAIN=4
OLLAMA_URL=http://localhost:11434
ANA_SEND_DELAY=13
ANA_UI_FPS=12
