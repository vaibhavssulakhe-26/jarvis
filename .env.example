GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
GROQ_VISION_MODEL=qwen/qwen3.8-27b
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemma-4-26b-a4b-it:free,nvidia/nemotron-3.5-lightning:free
JARVIS_STT=local
USER_PET_NAME=
USER_SHORT_NAME=
USER_FULL_NAME=
USER_GOD_NAME=
JARVIS_VOICE=en_US-amy-medium
JARVIS_BROWSER=
JARVIS_TRUSTED_CONTACTS=
# Wake word model: a name matching a file in models/, or a full path to a custom .onnx
WAKE_WORD=alexa
WAKE_THRESHOLD=0.4
JARVIS_PROACTIVE=on
# Where lasting facts about the user are kept
MEMORY_FILE=data/memory.json
# Offline fallback model (ollama pull phi4-mini); empty picks any installed local model
OLLAMA_MODEL=phi4-mini
ASSISTANT_NAME=Jarvis
USER_NAME=
MIC_GAIN=4
OLLAMA_URL=http://localhost:11434
JARVIS_SEND_DELAY=13
JARVIS_UI_FPS=12
