# Copy to .env and fill in. Never commit .env.

# Names (spoken to you; never learned from conversation)
USER_NAME=
USER_PET_NAME=
# What Jarvis calls you in greetings and replies (default USER_NAME)
USER_NICKNAME=
USER_SHORT_NAME=
USER_FULL_NAME=
USER_GOD_NAME=
ASSISTANT_NAME=Jarvis

# hybrid: cloud first, Ollama as backup. offline: cloud providers (and cloud speech recognition) are never called
BRAIN=hybrid

# Brain: Groq first, OpenRouter second, Ollama offline
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
# GROQ_VISION_MODEL=
OPENROUTER_API_KEY=
# OPENROUTER_MODEL=
OLLAMA_URL=http://localhost:11434
# Offline backup model. Unset: Jarvis picks the largest installed model that fits the free memory at startup
# (under 2 GB free: a 1B model, 2 to 4 GB: up to 4B, above 4 GB: up to 9B). Set it to force one.
# OLLAMA_MODEL=llama3.2:1b
# Tokens per minute the brain may send to each provider before moving to the next (Groq default 8000)
# GROQ_TPM=
# OPENROUTER_TPM=

# Voice
WAKE_WORD=alexa
WAKE_THRESHOLD=0.4
MIC_GAIN=4
# First-run voice only; after that the choice is saved in data/settings.json. Unset picks the best installed voice.
# VOICE=en_US-ryan-medium
# Speaking speed: 1 is normal (Piper length_scale 0.92), 1.2 is faster
# VOICE_SPEED=1
# local or groq
STT=local
# Groq model for STT=groq
# STT_MODEL=whisper-large-v3
# English unless you say "listen in Hindi / Kannada"; auto only accepts English, Hindi or Kannada
STT_LANGUAGE=en
# Multilingual model for the local fallback (tiny, base, small)
# STT_LOCAL_MODEL=small

# Daily digest, quiet hours, weather
WEATHER_CITY=
DIGEST_TIME=07:30
QUIET_START=23:00
QUIET_END=07:00
# NEWS_FEEDS=

# Email (Gmail app password, not your account password)
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=
MAIL_FETCH=25
MAIL_VIP=
EMAIL_USE_CLOUD=true

# Monitors and proactive nudges
SPEAK_MONITOR_ALERTS=false
# Battery and late-night warnings
JARVIS_PROACTIVE=on
# Chatty check-ins when you have been quiet: off, low (1 an hour at most) or normal (3 an hour at most)
PROACTIVE=off

# Focus guard (off until you turn it on by voice or set this to true)
DISTRACTION_GUARD=false
DISTRACTION_LIMIT_MIN=25
GUARD_USE_CLOUD=true
STUDY_KEYWORDS=

# Clipboard monitor (off until you turn it on by voice or set this to true)
CLIPBOARD_MONITOR=false

# Code helper: where builds go, and an optional separate model for code
# CODE_WORKSPACE=~/Projects/jarvis-builds
# CODE_PROVIDER=openrouter
# CODE_MODEL=

# mpv plays videos and music in one window (needs mpv); browser keeps the old behaviour
# PLAYER=mpv
# Extra mpv flags. Default: --gpu-api=opengl (the Vulkan renderer crashes on this Radeon) and --hwdec=no (VA-API never engaged and
# stalled once in tests; software decoding dropped the fewest frames). Set empty to pass nothing.
# MPV_ARGS=--gpu-api=opengl --hwdec=no
# yt-dlp format for videos (default: bestvideo[height<=720]+bestaudio/best[height<=720]/best)
# YT_FORMAT=
# mpv's own volume, 0 to 100 (default 50), so your voice carries over the speakers
# MPV_VOLUME=50
# true: songs also open a video window (default false, audio only)
# MUSIC_VIDEO=false
# Print the best wake score whenever it passes 0.15
# WAKE_DEBUG=0
# WAKE_THRESHOLD=0.4
# Score needed to cut off speech with the wake word (default: WAKE_THRESHOLD plus 0.3)
# BARGE_THRESHOLD=

# Channels "play a video on X" prefers, comma separated (default: freeCodeCamp,Abdul Bari,take U forward,NeetCode,Apna College)
# STUDY_CHANNELS=

# Browser for "open a website" and "search" (default google-chrome)
# BROWSER=google-chrome

# Hand-off outbox for "send this to my phone"; unset uses data/outbox
# HANDOFF_DIR=

# Messaging and misc
JARVIS_TRUSTED_CONTACTS=
JARVIS_SEND_DELAY=13
# JARVIS_BROWSER=
JARVIS_UI_FPS=12
MEMORY_FILE=data/memory.json
# JARVIS_DATA=

# Seconds Jarvis keeps listening after a reply without the wake word (default 10); closed while music or video plays
# FOLLOWUP_SECONDS=10
# Words the speech recogniser should spell right, comma separated
# STT_HINTS=Jarvis, Vibe, DSA, data structures and algorithms, LeetCode, mpv, Python, VS Code

# Notes and PDF search: NOTES_DIR defaults to data/notes; RAG_FOLDERS adds more folders (comma separated)
# NOTES_DIR=
# RAG_FOLDERS=~/Documents/study,~/Documents/papers

# Focus timer: true mutes desktop notifications (Plasma do not disturb) while a focus session runs
# FOCUS_MUTE_NOTIFICATIONS=false

# Dictation: hold this key, speak, release to paste the text into the focused window. Empty = off.
# Needs the input group (sudo usermod -aG input $USER, then log out and in), or bind
# python -m jarvis.voice.dictate --once to a KDE shortcut instead.
# DICTATE_KEY=

# Browser control (Playwright, its own profile in data/browser-profile, never your real Chrome profile)
# BROWSER_HEADLESS=false
# Search engine for "search for X" in the controlled browser: duckduckgo (default), google, youtube or github
# BROWSER_SEARCH=duckduckgo
# true: block images, video and fonts to save memory
# BROWSER_LITE=false
# chrome (default when Google Chrome is installed) or chromium for Playwright's own build
# BROWSER_CHANNEL=
# Minutes without a command before the browser closes itself (default 20)
# BROWSER_IDLE_MINUTES=20
# Where approved downloads go (default ~/Downloads)
# BROWSER_DOWNLOADS=

# Dashboard: the theme, state colours, hue cycling and low power mode are saved in data/settings.json (Settings page or "change theme to red").
# Low power also switches on by itself when free memory drops below 1.5 GB.

# Dashboard Study page and sidebar entry (off hides them)
STUDY=off

# Routines (data/routines.md is created on first use; edit it by hand or say "add routine ...")
# Time of the morning briefing routine, 24 hour clock
BRIEFING_TIME=08:00
# Private iCal link for your calendar (Google Calendar: Settings, your calendar, "Secret address in iCal format").
# Read only and never printed. Leave empty to skip the calendar.
CALENDAR_ICS_URL=

# Traces: one JSON line per request in data/traces.jsonl (rotated at 5 MB). off stops writing them.
# TRACES=on

# Profiles: two people on one machine. JARVIS_PROFILE=name reads .env.<name> first and keeps data in data/profiles/<name>/
# JARVIS_PROFILE=

# Job-search helper (tracker, job analysis against data/profile.md, drafts, mock interview). Off unless on.
# It never applies, sends or scrapes. Put your base resume text in data/profile.md.
JOBS=off
# off keeps job text and resume summaries on this laptop (the small offline model) instead of Groq / OpenRouter
JOBS_USE_CLOUD=true
