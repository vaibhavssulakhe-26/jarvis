[Unit]
Description=Jarvis reminders
PartOf=graphical-session.target
After=graphical-session.target

[Service]
ExecStart=%h/Documents/JARVIS/.venv/bin/python -u -m jarvis.scheduling.daemon
WorkingDirectory=%h/Documents/JARVIS
Restart=on-failure
RestartSec=5
MemoryMax=600M

[Install]
WantedBy=graphical-session.target
